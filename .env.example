# Скопируйте в `.env` и при необходимости измените (не коммитить `.env` с секретами).
# Docker Compose подхватывает переменные из `.env` в каталоге проекта.

# Опционально: имя сервиса для логов и документации.
# SERVICE_NAME=april-worker

# Публичный базовый URL API (подставьте свой хост после деплоя).
# PUBLIC_API_BASE_URL=https://dev.example.com/api

# Порт HTTP для Nginx (статика Docusaurus + OpenAPI + Swagger UI на хосте).
DOCS_HTTP_PORT=8080

# Порт Structurizr Lite на хосте (модель C4).
STRUCTURIZR_HTTP_PORT=8091

# AprilHub runtime profile
# UID/GID владельца **репо на хосте** (см. `id -u` / `id -g`); иначе bind-mount: EACCES у npm/go в dev-образах.
# LOCAL_UID=1000
# LOCAL_GID=1000
HUB_BFF_PORT=8081
HUB_SHELL_PORT=4173
# hub-shell в compose: `npm ci` не на каждый старт, а при смене `package-lock.json` (стамп `node_modules/.aprilhub-ci-stamp`).
# После `git pull` с обновлённым lock: удалите `hub-shell/node_modules` и стамп, либо дайте одному `up` догнать зависимости.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_HOSTNAME=https://dev.april.ukituki.tech/auth
KEYCLOAK_REALM=april
KEYCLOAK_URL=http://keycloak:8080/auth
KEYCLOAK_ISSUER=http://127.0.0.1/auth/realms/april
KEYCLOAK_JWKS_URL=http://keycloak:8080/auth/realms/april/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=aprilhub-shell
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
VITE_API_BASE_URL=/api
VITE_KEYCLOAK_URL=/auth
VITE_KEYCLOAK_REALM=april
VITE_KEYCLOAK_CLIENT_ID=aprilhub-shell
# Sentry rollout preparation (task 035): runtime integration comes in task 037.
# Do not commit real DSN values to git.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=dev
# SENTRY_RELEASE=local-dev
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.0
# SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
# AprilProfile: published `entity_type_id` для сценария создания профиля (POST /v1/entities) из hub-shell виджета.
# VITE_PROFILE_DEFAULT_ENTITY_TYPE_ID=
# Опционально: заранее известный `entity_id` для демо/отладки (если не задан — создаётся при первом сохранении).
# VITE_PROFILE_DEMO_ENTITY_ID=
# CSV-список `entity_id` для виджета списка профилей (`ProfilesListWidget`).
# VITE_PROFILE_LIST_ENTITY_IDS=00000000-0000-0000-0000-000000000001
# CSV-список `instance/entity_id` для виджета экземпляров (`ProfileInstancesHostWidget`).
# VITE_PROFILE_INSTANCE_IDS=00000000-0000-0000-0000-000000000001
# `entity_id` для сценария merge в `ConflictsMergeHostWidget` (два разных id в БД AprilProfile).
# VITE_PROFILE_MERGE_SOURCE_ENTITY_ID=aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa
# VITE_PROFILE_MERGE_TARGET_ENTITY_ID=00000000-0000-0000-0000-000000000001
#
# Playwright e2e (hub-shell): персоны из dev-realm — см. docs/guides/APRILHUB_PLAYWRIGHT_PERSONAS.md
# PLAYWRIGHT_BASE_URL=http://localhost:8080
# PLAYWRIGHT_USER=april-dev
# PLAYWRIGHT_PASSWORD=april-dev-pass
# PLAYWRIGHT_RESTRICTED_USER=april-user
# PLAYWRIGHT_RESTRICTED_PASSWORD=april-user-pass
# В одной docker-сети: `http://april-profile:8000` (см. compose). На хосте, если hub-bff и
# AprilProfile в разных проектах — URL с IP/портом published, например `http://192.168.1.42:18081`.
# Для агрегации overview (опционально): `APRIL_PROFIL_URL` с тем же базовым URL.
APRIL_PROFILE_ADMIN_URL=http://april-profile:8000
APRIL_PROFIL_URL=
# AprilProfile на том же стенде, что и Hub: в env **сервиса** AprilProfile задайте
# `KEYCLOAK_AUDIENCE=aprilhub-shell`, чтобы тот же access token, что у `aprilhub-shell`, проходил
# проверку `azp` (иначе по умолчанию ожидается `april-profile-api`).
# Разрешённые host-заголовки для Vite dev server (через запятую).
VITE_ALLOWED_HOSTS=dev.april.ukituki.tech,localhost,127.0.0.1
