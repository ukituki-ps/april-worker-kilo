{
  "realm": "april",
  "enabled": true,
  "displayName": "April Dev Realm",
  "roles": {
    "realm": [
      { "name": "user" },
      { "name": "manager" },
      { "name": "admin" }
    ]
  },
  "clients": [
    {
      "clientId": "aprilhub-shell",
      "name": "AprilHub Shell",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:4173/*"
      ],
      "webOrigins": [
        "http://localhost:4173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "aprilhub-bff",
      "name": "AprilHub BFF",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-only-secret",
      "protocol": "openid-connect",
      "serviceAccountsEnabled": true,
      "attributes": {
        "access.token.lifespan": "300"
      }
    }
  ],
  "users": [
    {
      "username": "april-dev",
      "enabled": true,
      "emailVerified": true,
      "firstName": "April",
      "lastName": "Developer",
      "email": "april-dev@example.local",
      "credentials": [
        {
          "type": "password",
          "value": "april-dev-pass",
          "temporary": false
        }
      ],
      "realmRoles": ["user"]
    }
  ]
}
