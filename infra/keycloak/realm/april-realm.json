{
  "realm": "april",
  "enabled": true,
  "displayName": "April Dev Realm",
  "loginTheme": "aprilhub",
  "accountTheme": "aprilhub",
  "internationalizationEnabled": true,
  "supportedLocales": ["ru", "en"],
  "defaultLocale": "ru",
  "roles": {
    "realm": [
      { "name": "user" },
      { "name": "manager" },
      { "name": "admin" }
    ]
  },
  "clients": [
    {
      "clientId": "aprilhub-shell",
      "name": "AprilHub Shell",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:4173/*",
        "http://localhost:8080/*",
        "http://localhost:18080/*",
        "http://dev.april.ukituki.tech/*",
        "https://dev.april.ukituki.tech/*"
      ],
      "webOrigins": [
        "http://localhost:4173",
        "http://localhost:8080",
        "http://localhost:18080",
        "http://dev.april.ukituki.tech",
        "https://dev.april.ukituki.tech"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "aprilhub-bff",
      "name": "AprilHub BFF",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-only-secret",
      "protocol": "openid-connect",
      "serviceAccountsEnabled": true,
      "attributes": {
        "access.token.lifespan": "300"
      }
    },
    {
      "clientId": "april-profile-api",
      "name": "AprilProfile API",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "tenant_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "tenant_id",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "april-dev",
      "enabled": true,
      "emailVerified": true,
      "firstName": "April",
      "lastName": "Developer",
      "email": "april-dev@example.local",
      "credentials": [
        {
          "type": "password",
          "value": "april-dev-pass",
          "temporary": false
        }
      ],
      "attributes": {
        "tenant_id": ["tenant-dev"]
      },
      "realmRoles": ["user", "admin"]
    },
    {
      "username": "april-user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "April",
      "lastName": "UserOnly",
      "email": "april-user@example.local",
      "credentials": [
        {
          "type": "password",
          "value": "april-user-pass",
          "temporary": false
        }
      ],
      "attributes": {
        "tenant_id": ["tenant-dev"]
      },
      "realmRoles": ["user"]
    }
  ]
}
