      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(april_profile_http_request_duration_seconds_bucket{job=\"aprilhub_dynamic_targets\",env=~\"$env\",stand=~\"$stand\",host=~\"$host\",service=~\"$service\"}[5m])) by (le, route)) * 1000",
          "legendFormat": "{{route}} p95",
          "refId": "A"
        }
      ],
      "title": "HTTP latency p95 by route",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(april_profile_http_requests_total{job=\"aprilhub_dynamic_targets\",env=~\"$env\",stand=~\"$stand\",host=~\"$host\",service=~\"$service\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(april_profile_http_requests_total{job=\"aprilhub_dynamic_targets\",env=~\"$env\",stand=~\"$stand\",host=~\"$host\",service=~\"$service\"}[5m])), 0.001)",
          "legendFormat": "5xx_ratio",
          "refId": "A"
        }
      ],
      "title": "HTTP 5xx error ratio",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(april_profile_http_requests_total{job=\"aprilhub_dynamic_targets\",env=~\"$env\",stand=~\"$stand\",host=~\"$host\",service=~\"$service\",route=\"/readyz\",status!~\"2..\"}[5m])) by (status)",
          "legendFormat": "/readyz {{status}}",
          "refId": "A"
        }
      ],
      "title": "Readiness (/readyz) non-2xx rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
