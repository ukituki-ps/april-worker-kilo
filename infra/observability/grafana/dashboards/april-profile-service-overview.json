        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "max(april_profile_source_sync_lag_seconds{job=\"aprilhub_dynamic_targets\",env=~\"$env\",stand=~\"$stand\",host=~\"$host\",service=~\"$service\"}) by (tenant_id, source_system)",
          "legendFormat": "{{tenant_id}} / {{source_system}}",
          "refId": "A"
        }
      ],
      "title": "Source sync lag (max by tenant / source_system)",
      "type": "timeseries"
    }
