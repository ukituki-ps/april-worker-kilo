        }
      },
      "targets": [
        {
          "expr": "sum(rate(april_profile_http_requests_total{job=\"aprilhub_dynamic_targets\",env=~\"$env\",stand=~\"$stand\",host=~\"$host\",service=~\"$service\"}[5m])) by (route, status)",
          "legendFormat": "{{route}} {{status}}",
          "refId": "A"
        }
      ],
      "title": "HTTP request rate (by route / status)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
