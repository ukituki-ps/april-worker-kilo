# Copy this file to .env in infra/observability/env/.
# Never commit real passwords or internal hostnames from production.

# Host naming
HOST_ALIAS=dev-observability-host
PROM_ENV=dev

# Exposed ports
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
LOKI_PORT=3100
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8088

# Grafana auth
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_ROOT_URL=http://localhost:3000

# Promtail push endpoint
LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push
