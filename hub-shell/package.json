{
  "name": "hub-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ds:prepare": "sh ./scripts/ds-prepare.sh",
    "ds:check-exports": "node ./scripts/check-ui-exports.mjs",
    "predev": "npm run ds:prepare",
    "prebuild": "npm run ds:prepare",
    "prelint": "npm run ds:prepare",
    "pretest": "npm run ds:prepare",
    "dev": "vite",
      "build": "npm run ds:check-exports && tsc --noEmit && vite build",
      "build:analyze": "npm run ds:check-exports && tsc --noEmit && vite build --report",
      "bundle:report": "du -sh dist"
    "lint": "npm run ds:check-exports && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test tests/e2e/guest.spec.ts tests/e2e/shell-privileged.spec.ts tests/e2e/profile-widgets-smoke.spec.ts",
    "e2e:install": "playwright install --with-deps chromium",
    "preview": "vite preview --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "@april/tokens": "npm:@ukituki-ps/april-tokens@^0.1.13",
    "@april/ui": "npm:@ukituki-ps/april-ui@^0.1.13",
    "@emotion/react": "^11.14.0",
    "@mantine/core": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@sentry/react": "^10.50.0",
    "@tabler/icons-react": "^3.41.1",
    "keycloak-js": "^26.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "jsdom": "^24.1.3",
    "playwright": "^1.53.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  }
}
